{
  "manifest_version": 3,
  "name": "Slack Web",
  "version": "0.1.0",
  "description": "Open Slack message and channel links in the browser using Slack’s own browser link.",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*.slack.com/*",
    "https://*.slack.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "launch_pages",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.slack.com/archives/*",
        "https://*.slack.com/ssb/redirect*",
        "https://*.slack.com/app_redirect*"
      ],
      "js": [
        "open-in-browser.js"
      ],
      "run_at": "document_end"
    }
  ]
}
